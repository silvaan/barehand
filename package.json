{
  "name": "barehand",
  "version": "0.1.0",
  "description": "Out-of-band PC technician for AI agents: see the screen, type on the keyboard, press the power button and boot ISOs on another machine through minimal hardware, exposed as an MCP server plus a skill.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvaan/barehand.git"
  },
  "bin": {
    "barehand": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "firmware",
    "lab",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "serve": "node dist/cli.js serve",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pngjs": "^7.0.0",
    "serialport": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
