CONFIG_IDF_TARGET="esp32s3"

# UART0 is the command link to the controller: keep IDF logs off it.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# TinyUSB: 3 HID interfaces (boot keyboard, boot mouse, absolute pointer) + 1 CDC-ACM.
CONFIG_TINYUSB_HID_COUNT=3
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
